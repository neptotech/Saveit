{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SaveIt",
  "version": "1.0.0",
  "identifier": "com.saveit.desktop",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "SaveIt",
        "width": 1200,
        "height": 820,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}
